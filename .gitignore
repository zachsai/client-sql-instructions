# ===================================
# Sensitive Files - Never Commit These
# ===================================

# Environment files with credentials
.env
.env.local
.env.*.local

# Database credentials files
**/credentials.txt
**/passwords.txt
**/config.ini
**/secrets.*

# Actual client data or SQL dumps
*.sql.gz
*.sql.zip
**/backups/
**/dumps/

# ===================================
# Docker & Database
# ===================================

# Docker volumes (contains actual database data)
**/mysql_data/
**/mssql_data/

# Temporary ngrok logs
/tmp/ngrok.log
ngrok.log

# ===================================
# Python
# ===================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===================================
# Testing & Development
# ===================================

# Test databases
test_database/
*.db
*.sqlite
*.sqlite3

# Internal troubleshooting notes
TROUBLESHOOTING_*.md

# Temporary files
*.tmp
*.bak
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ===================================
# Keep These Files (Examples)
# ===================================

# We want to keep example/template files:
!docker-compose.example.yml
!.env.example
!init/init.sql
!examples/*.py
!sql-scripts/**/*.sql
